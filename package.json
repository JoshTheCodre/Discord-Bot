{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "A Discord bot for task management with Firebase integration",
  "main": "src/bot.js",
  "type": "commonjs",
  "scripts": {
    "build": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "start": "node src/bot.js",
    "dev": "node src/bot.js",
    "backfill:subtasks": "node src/scripts/backfillSubtasks.js",
    "push:github": "git push origin main",
    "push:heroku": "git push heroku main",
    "push": "git push origin main && git push heroku main",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "discord",
    "bot",
    "task-management",
    "firebase"
  ],
  "author": "JoshTheCodre",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "bcryptjs": "^3.0.3",
    "discord.js": "^14.22.1",
    "dotenv": "^16.3.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "firebase": "^12.4.0",
    "googleapis": "^161.0.0",
    "helmet": "^8.1.0",
    "node-cron": "^4.2.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14"
  }
}
