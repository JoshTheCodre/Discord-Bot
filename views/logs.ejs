<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logs — SolomaxStudios Task Manager</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #F5F7FA; }
    </style>
</head>
<body>
<div class="flex min-h-screen">

    <!-- Sidebar -->
    <aside class="w-60 bg-white border-r border-gray-200 min-h-screen flex flex-col flex-shrink-0">
        <div class="px-5 py-5 border-b border-gray-100">
            <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-layer-group text-white" style="font-size:11px;"></i>
                </div>
                <div class="min-w-0">
                    <p class="font-semibold text-gray-900 text-xs tracking-tight leading-tight">SolomaxStudios</p>
                    <p class="text-gray-400 text-xs leading-tight">Task Manager</p>
                </div>
            </div>
        </div>
        <nav class="px-3 py-4 flex-1 space-y-0.5">
            <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                <i class="fas fa-home w-4 text-center text-gray-400" style="font-size:13px;"></i>
                <span>Dashboard</span>
            </a>
            <a href="/tasks" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                <i class="fas fa-list-check w-4 text-center text-gray-400" style="font-size:13px;"></i>
                <span>Tasks</span>
            </a>
            <a href="/performance" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                <i class="fas fa-chart-line w-4 text-center text-gray-400" style="font-size:13px;"></i>
                <span>Performance</span>
            </a>
            <a href="/flags" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 transition-colors" onmouseenter="this.style.background='#fef2f2';this.style.color='#dc2626';this.querySelector('i').style.color='#dc2626';" onmouseleave="this.style.background='';this.style.color='';this.querySelector('i').style.color='#9ca3af';">
                <i class="fas fa-triangle-exclamation w-4 text-center text-gray-400" style="font-size:13px;"></i>
                <span>Flagged</span>
            </a>
            <a href="/logs" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm bg-blue-50 text-blue-600 font-medium transition-colors">
                <i class="fas fa-scroll w-4 text-center text-blue-500" style="font-size:13px;"></i>
                <span>Logs</span>
            </a>
        </nav>
        <div class="px-3 py-3 border-t border-gray-100">
            <div class="px-3 py-2 mb-1">
                <p class="text-xs font-medium text-gray-700 truncate"><%= adminName || 'Admin' %></p>
                <p class="text-xs text-gray-400">Administrator</p>
            </div>
            <form method="POST" action="/logout">
                <button type="submit" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 hover:bg-red-50 hover:text-red-600 transition-colors text-left">
                    <i class="fas fa-arrow-right-from-bracket w-4 text-center" style="font-size:13px;"></i>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0">
        <header class="bg-white border-b border-gray-200 px-8 py-5">
            <div class="flex items-center justify-between">
                <h1 class="text-xl font-semibold text-gray-900">Logs</h1>
                <span class="text-sm text-gray-400"><%= logs.length %> entries</span>
            </div>
        </header>

        <!-- Category Tabs -->
        <div class="bg-white border-b border-gray-200 px-8">
            <div class="flex gap-1 -mb-px overflow-x-auto">
                <% const categories = [
                    { key: 'all',        label: 'All',         icon: 'fa-list' },
                    { key: 'assignment', label: 'Assignments', icon: 'fa-user-plus' },
                    { key: 'completion', label: 'Completions', icon: 'fa-circle-check' },
                    { key: 'copyright',  label: 'Copyright',   icon: 'fa-triangle-exclamation' },
                    { key: 'user',       label: 'Users',       icon: 'fa-user' },
                    { key: 'reminder',   label: 'Reminders',   icon: 'fa-bell' },
                    { key: 'system',     label: 'System',      icon: 'fa-gear' }
                ]; %>
                <% categories.forEach(cat => { %>
                    <a href="/logs?category=<%= cat.key %>"
                       class="flex items-center gap-1.5 px-4 py-3 text-sm font-medium border-b-2 whitespace-nowrap transition-colors
                              <%= activeCategory === cat.key
                                  ? 'border-blue-600 text-blue-600'
                                  : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %>">
                        <i class="fas <%= cat.icon %>" style="font-size:12px;"></i>
                        <%= cat.label %>
                    </a>
                <% }); %>
            </div>
        </div>

        <!-- Log Entries -->
        <div class="flex-1 px-8 py-6">
            <% if (logs.length === 0) { %>
            <div class="text-center py-20 text-gray-400">
                <i class="fas fa-scroll text-4xl mb-3 block"></i>
                <p class="text-sm">No log entries found for this category.</p>
            </div>
            <% } else { %>
            <div class="space-y-2">
                <% logs.forEach(entry => { %>
                <%
                    const typeColors = {
                        task_assigned:    { bg: 'bg-blue-50',   text: 'text-blue-700',   border: 'border-blue-200'   },
                        task_created:     { bg: 'bg-blue-50',   text: 'text-blue-700',   border: 'border-blue-200'   },
                        approval:         { bg: 'bg-green-50',  text: 'text-green-700',  border: 'border-green-200'  },
                        subtask_submitted:{ bg: 'bg-green-50',  text: 'text-green-700',  border: 'border-green-200'  },
                        copyright_flagged:{ bg: 'bg-amber-50',  text: 'text-amber-700',  border: 'border-amber-200'  },
                        copyright_resolved:{bg: 'bg-emerald-50',text: 'text-emerald-700',border: 'border-emerald-200'},
                        user_created:     { bg: 'bg-purple-50', text: 'text-purple-700', border: 'border-purple-200' },
                        user_auto_created:{ bg: 'bg-purple-50', text: 'text-purple-700', border: 'border-purple-200' },
                        reminder_sent:    { bg: 'bg-sky-50',    text: 'text-sky-700',    border: 'border-sky-200'    },
                        dm_sent:          { bg: 'bg-gray-50',   text: 'text-gray-600',   border: 'border-gray-200'   },
                        dm_failed:        { bg: 'bg-red-50',    text: 'text-red-700',    border: 'border-red-200'    },
                        error:            { bg: 'bg-red-50',    text: 'text-red-700',    border: 'border-red-200'    }
                    };
                    const colors = typeColors[entry.type] || { bg: 'bg-gray-50', text: 'text-gray-600', border: 'border-gray-200' };
                    const ts = entry.timestamp ? new Date(entry.timestamp) : null;
                    const dateStr = ts ? ts.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
                    const timeStr = ts ? ts.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
                %>
                <div class="bg-white border border-gray-100 rounded-xl px-5 py-3.5 flex items-start gap-4">
                    <!-- Type badge -->
                    <span class="flex-shrink-0 mt-0.5 px-2 py-0.5 rounded-md text-xs font-semibold border <%= colors.bg %> <%= colors.text %> <%= colors.border %>">
                        <%= entry.type || 'log' %>
                    </span>

                    <!-- Message + meta -->
                    <div class="flex-1 min-w-0">
                        <p class="text-sm text-gray-800 leading-snug"><%= entry.message || '—' %></p>
                        <div class="flex flex-wrap gap-x-3 gap-y-0.5 mt-1">
                            <% if (entry.username) { %>
                            <span class="text-xs text-gray-400"><i class="fas fa-user mr-1" style="font-size:10px;"></i><%= entry.username %></span>
                            <% } %>
                            <% if (entry.taskId) { %>
                            <span class="text-xs text-gray-400"><i class="fas fa-hashtag mr-1" style="font-size:10px;"></i><%= entry.taskId %></span>
                            <% } %>
                            <% if (entry.subtaskTitle) { %>
                            <span class="text-xs text-gray-400 truncate max-w-xs"><i class="fas fa-subtitles mr-1" style="font-size:10px;"></i><%= entry.subtaskTitle %></span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Timestamp -->
                    <% if (ts) { %>
                    <div class="flex-shrink-0 text-right">
                        <p class="text-xs text-gray-400"><%= timeStr %></p>
                        <p class="text-xs text-gray-300"><%= dateStr %></p>
                    </div>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>
    </div>
</div>
</body>
</html>
