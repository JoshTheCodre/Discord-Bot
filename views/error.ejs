<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Task Bot Dashboard</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #F5F7FA; }
    </style>
</head>
<body>
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="w-60 bg-white border-r border-gray-200 min-h-screen flex flex-col flex-shrink-0">
            <div class="px-5 py-5 border-b border-gray-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-layer-group text-white" style="font-size:11px;"></i>
                    </div>
                    <span class="font-semibold text-gray-900 text-sm tracking-tight">Task Bot</span>
                </div>
            </div>
            <nav class="px-3 py-4 flex-1 space-y-0.5">
                <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-home w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/tasks" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-list-check w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Tasks</span>
                </a>
                <a href="/users" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-users w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Users</span>
                </a>
                <a href="/leaderboard" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-ranking-star w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Leaderboard</span>
                </a>
                <a href="/copyright" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 transition-colors" onmouseenter="this.style.background='#fef2f2';this.style.color='#dc2626';this.querySelector('i').style.color='#dc2626';" onmouseleave="this.style.background='';this.style.color='';this.querySelector('i').style.color='#9ca3af';">
                    <i class="fas fa-triangle-exclamation w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Copyright</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <header class="bg-white border-b border-gray-200 px-8 py-5">
                <h1 class="text-xl font-semibold text-gray-900">Error</h1>
            </header>

            <main class="flex-1 px-8 py-7 flex items-start justify-center">
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-12 text-center max-w-lg w-full mt-8">

                    <div class="w-14 h-14 bg-red-50 border border-red-100 rounded-full flex items-center justify-center mx-auto mb-5">
                        <i class="fas fa-triangle-exclamation text-red-500" style="font-size:20px;"></i>
                    </div>

                    <p class="text-5xl font-bold text-gray-900 mb-2"><%= statusCode || 500 %></p>
                    <p class="text-base text-gray-500 mb-7"><%= message || 'An error occurred' %></p>

                    <% if (details) { %>
                        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-7 text-left">
                            <p class="text-xs text-gray-600 font-mono leading-relaxed whitespace-pre-wrap"><%= details %></p>
                        </div>
                    <% } %>

                    <div class="flex items-center justify-center gap-3">
                        <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium bg-blue-600 text-white hover:bg-blue-700 transition-colors">
                            <i class="fas fa-home" style="font-size:12px;"></i> Go to Dashboard
                        </a>
                        <a href="javascript:history.back()" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors">
                            <i class="fas fa-arrow-left" style="font-size:12px;"></i> Go Back
                        </a>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
