<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Task Bot Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <div class="flex">
        <!-- Sidebar -->
        <div class="bg-white shadow-lg w-64 p-6 min-h-screen">
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-blue-600">
                    <i class="fas fa-robot mr-2"></i>Task Bot
                </h1>
            </div>
            
            <nav class="space-y-2">
                <a href="/" class="block px-4 py-2 rounded-lg text-gray-700 hover:bg-blue-100">
                    <i class="fas fa-home mr-2"></i> Dashboard
                </a>
                <a href="/tasks" class="block px-4 py-2 rounded-lg text-gray-700 hover:bg-blue-100">
                    <i class="fas fa-tasks mr-2"></i> Tasks
                </a>
                <a href="/users" class="block px-4 py-2 rounded-lg text-gray-700 hover:bg-blue-100">
                    <i class="fas fa-users mr-2"></i> Users
                </a>
                <a href="/leaderboard" class="block px-4 py-2 rounded-lg text-gray-700 hover:bg-blue-100">
                    <i class="fas fa-trophy mr-2"></i> Leaderboard
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-1">
            <!-- Header -->
            <header class="bg-white shadow">
                <div class="max-w-7xl mx-auto px-6 py-4">
                    <h2 class="text-3xl font-bold text-gray-900">Error</h2>
                </div>
            </header>

            <!-- Content -->
            <main class="max-w-7xl mx-auto px-6 py-8">
                <div class="bg-white rounded-lg shadow p-12 text-center">
                    <div class="inline-flex items-center justify-center w-20 h-20 bg-red-100 rounded-full mb-6">
                        <i class="fas fa-exclamation-triangle text-4xl text-red-600"></i>
                    </div>
                    
                    <h1 class="text-4xl font-bold text-gray-900 mb-2">
                        <%= statusCode || 500 %>
                    </h1>
                    
                    <p class="text-xl text-gray-600 mb-8">
                        <%= message || 'An error occurred' %>
                    </p>

                    <% if (details) { %>
                        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-8 text-left max-w-2xl mx-auto">
                            <p class="text-sm text-red-800 font-mono"><%= details %></p>
                        </div>
                    <% } %>

                    <div class="space-x-4">
                        <a href="/" class="inline-flex items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-blue-600 hover:bg-blue-700 transition">
                            <i class="fas fa-home mr-2"></i> Go to Dashboard
                        </a>
                        <a href="javascript:history.back()" class="inline-flex items-center px-6 py-3 border border-gray-300 rounded-md shadow-sm text-base font-medium text-gray-700 bg-white hover:bg-gray-50 transition">
                            <i class="fas fa-arrow-left mr-2"></i> Go Back
                        </a>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
