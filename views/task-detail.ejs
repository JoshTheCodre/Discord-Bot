<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= task.movieName || task.title || 'Task' %> - Task Bot Dashboard</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #F5F7FA; }
    </style>
</head>
<body>
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="w-60 bg-white border-r border-gray-200 min-h-screen flex flex-col flex-shrink-0">
            <div class="px-5 py-5 border-b border-gray-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-layer-group text-white" style="font-size:11px;"></i>
                    </div>
                    <span class="font-semibold text-gray-900 text-sm tracking-tight">Task Bot</span>
                </div>
            </div>
            <nav class="px-3 py-4 flex-1 space-y-0.5">
                <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-home w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/tasks" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm bg-blue-50 text-blue-600 font-medium transition-colors">
                    <i class="fas fa-list-check w-4 text-center text-blue-500" style="font-size:13px;"></i>
                    <span>Tasks</span>
                </a>
                <a href="/users" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-users w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Users</span>
                </a>
                <a href="/leaderboard" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-ranking-star w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Leaderboard</span>
                </a>
                <a href="/copyright" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 transition-colors" onmouseenter="this.style.background='#fef2f2';this.style.color='#dc2626';this.querySelector('i').style.color='#dc2626';" onmouseleave="this.style.background='';this.style.color='';this.querySelector('i').style.color='#9ca3af';">
                    <i class="fas fa-triangle-exclamation w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Copyright</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <header class="bg-white border-b border-gray-200 px-8 py-5">
                <div class="flex items-center gap-3">
                    <a href="/tasks" class="text-gray-400 hover:text-gray-600 transition-colors">
                        <i class="fas fa-arrow-left" style="font-size:13px;"></i>
                    </a>
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">
                            <a href="/tasks" class="hover:text-gray-600 transition-colors">Tasks</a>
                            <span class="mx-1.5">/</span>
                        </p>
                        <h1 class="text-xl font-semibold text-gray-900"><%= task.movieName || task.title || 'Untitled' %></h1>
                    </div>
                </div>
            </header>

            <main class="flex-1 px-8 py-7">
                <%
                  const completedCount = task.subTasks?.filter(s => s.status === 'completed').length || 0;
                  const totalCount = task.subTasks?.length || 0;
                  const postedCount = task.subTasks?.filter(s => s.posted).length || 0;
                  const pct = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;
                  const isDone = task.status === 'completed';
                %>

                <!-- Task Summary -->
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 mb-5">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-medium mb-1">Status</p>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border
                                <%= isDone ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200' %>">
                                <%= isDone ? 'Completed' : 'In Progress' %>
                            </span>
                        </div>
                        <% if (task.dueDate) { %>
                        <div class="text-right">
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-medium mb-1">Due Date</p>
                            <p class="text-sm font-medium text-gray-700"><%= task.dueDate %></p>
                        </div>
                        <% } %>
                    </div>

                    <div class="grid grid-cols-3 gap-4 mb-6 pt-5 border-t border-gray-100">
                        <div>
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-medium mb-1">Subtasks</p>
                            <p class="text-2xl font-bold text-gray-900"><%= totalCount %></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-medium mb-1">Completed</p>
                            <p class="text-2xl font-bold text-emerald-600"><%= completedCount %></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-medium mb-1">Posted</p>
                            <p class="text-2xl font-bold text-blue-600"><%= postedCount %></p>
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <p class="text-xs text-gray-400 font-medium">Completion Progress</p>
                            <p class="text-xs font-semibold text-gray-600"><%= pct %>%</p>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-1.5">
                            <div class="bg-blue-500 h-1.5 rounded-full progress-fill" data-progress="<%= pct %>"></div>
                        </div>
                        <p class="text-xs text-gray-400 mt-1"><%= completedCount %> of <%= totalCount %> subtasks</p>
                    </div>
                </div>

                <!-- Subtasks -->
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm">
                    <div class="px-6 py-4 border-b border-gray-100">
                        <h2 class="text-sm font-semibold text-gray-900">Subtasks</h2>
                    </div>

                    <% if (!task.subTasks || task.subTasks.length === 0) { %>
                        <div class="text-center py-14">
                            <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
                                <i class="fas fa-inbox text-gray-300" style="font-size:16px;"></i>
                            </div>
                            <p class="text-sm text-gray-400">No subtasks found</p>
                        </div>
                    <% } else { %>
                        <div class="divide-y divide-gray-100">
                            <% task.subTasks.forEach(subtask => { %>
                                <div class="px-6 py-4 hover:bg-gray-50 transition-colors">
                                    <div class="flex items-start justify-between gap-4">
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-medium text-gray-900 truncate"><%= subtask.title %></p>

                                            <div class="flex flex-wrap gap-4 mt-2 text-xs text-gray-400">
                                                <% if (subtask.submittedBy) { %>
                                                <span class="flex items-center gap-1">
                                                    <i class="fas fa-user text-gray-300"></i>
                                                    Submitted by <span class="text-gray-600 font-medium ml-0.5"><%= subtask.submittedBy %></span>
                                                </span>
                                                <% } %>
                                                <% if (subtask.postedBy) { %>
                                                <span class="flex items-center gap-1">
                                                    <i class="fas fa-paper-plane text-gray-300"></i>
                                                    Posted by <span class="text-gray-600 font-medium ml-0.5"><%= subtask.postedBy %></span>
                                                </span>
                                                <% } %>
                                                <% if (subtask.submittedAt || subtask.completedAt) { %>
                                                <span class="flex items-center gap-1">
                                                    <i class="fas fa-clock text-gray-300"></i>
                                                    <%= new Date(subtask.submittedAt || subtask.completedAt).toLocaleDateString() %>
                                                </span>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-2 flex-shrink-0">
                                            <% if (subtask.status === 'completed') { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">Completed</span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500 border border-gray-200">Pending</span>
                                            <% } %>
                                            <% if (subtask.posted) { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">Posted</span>
                                            <% } %>
                                            <% if (subtask.copyrightIssue) { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-50 text-red-700 border border-red-200">Copyright</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </main>
        </div>
    </div>
    <script>
        document.querySelectorAll('.progress-fill[data-progress]').forEach((el) => {
            const p = Number(el.getAttribute('data-progress'));
            el.style.width = (Number.isFinite(p) ? Math.max(0, Math.min(100, p)) : 0) + '%';
        });
    </script>
</body>
</html>
