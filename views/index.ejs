<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Bot Dashboard</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #F5F7FA; }
    </style>
</head>
<body>
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="w-60 bg-white border-r border-gray-200 min-h-screen flex flex-col flex-shrink-0">
            <div class="px-5 py-5 border-b border-gray-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-layer-group text-white" style="font-size:11px;"></i>
                    </div>
                    <span class="font-semibold text-gray-900 text-sm tracking-tight">Task Bot</span>
                </div>
            </div>
            <nav class="px-3 py-4 flex-1 space-y-0.5">
                <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm bg-blue-50 text-blue-600 font-medium transition-colors">
                    <i class="fas fa-home w-4 text-center text-blue-500" style="font-size:13px;"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/tasks" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-list-check w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Tasks</span>
                </a>
                <a href="/performance" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-chart-line w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Performance</span>
                </a>
                <a href="/flags" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 transition-colors" onmouseenter="this.style.background='#fef2f2';this.style.color='#dc2626';this.querySelector('i').style.color='#dc2626';" onmouseleave="this.style.background='';this.style.color='';this.querySelector('i').style.color='#9ca3af';">
                    <i class="fas fa-triangle-exclamation w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Flagged</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <header class="bg-white border-b border-gray-200 px-8 py-5">
                <h1 class="text-xl font-semibold text-gray-900">Dashboard</h1>
            </header>

            <main class="flex-1 px-8 py-7">

                <!-- Stats Grid -->
                <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-7">

                    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-3">Total Tasks</p>
                        <p class="text-3xl font-bold text-gray-900"><%= totalTasks %></p>
                    </div>

                    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-3">Subtasks</p>
                        <p class="text-3xl font-bold text-gray-900"><%= totalSubtasks %></p>
                    </div>

                    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-3">Completed</p>
                        <p class="text-3xl font-bold text-emerald-600"><%= completedTasks %></p>
                    </div>

                    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-3">Posted</p>
                        <p class="text-3xl font-bold text-blue-600"><%= postedTasks %></p>
                    </div>

                    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-3">Users</p>
                        <p class="text-3xl font-bold text-gray-900"><%= totalUsers %></p>
                    </div>

                </div>

                <!-- Team Members -->
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-5">
                        <h2 class="text-sm font-semibold text-gray-900">Team</h2>
                        <a href="/performance" class="text-xs font-medium text-blue-600 hover:text-blue-700 transition-colors">View performance</a>
                    </div>
                    <% if (!users || users.length === 0) { %>
                    <p class="text-sm text-gray-400 text-center py-6">No team members found.</p>
                    <% } else { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                        <% users.forEach(user => { %>
                        <%
                          const uName = user.discordUsername || 'Unknown';
                          const uId = user.discordId || '';
                          const uInitials = String(uName).substring(0, 2).toUpperCase();
                          const uRate = user.completionRate || 0;
                        %>
                        <div class="flex flex-col gap-3 p-4 rounded-xl border border-gray-100 hover:border-gray-200 hover:shadow-sm transition-all">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                                    <%= uInitials %>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-sm font-semibold text-gray-900 truncate"><%= uName %></p>
                                    <p class="text-xs text-gray-400 truncate"><%= uId %></p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-100">
                                    <i class="fas fa-check" style="font-size:9px;"></i><%= user.completedCount || 0 %>
                                </span>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                    <i class="fas fa-paper-plane" style="font-size:9px;"></i><%= user.postedCount || 0 %>
                                </span>
                                <span class="ml-auto text-xs font-medium text-gray-500"><%= uRate %>%</span>
                            </div>
                            <div class="w-full bg-gray-100 rounded-full h-1">
                                <div class="bg-blue-500 h-1 rounded-full progress-fill" data-progress="<%= uRate %>"></div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                    <% } %>
                </div>

            </main>
        </div>
    </div>
    <script>
        document.querySelectorAll('.progress-fill[data-progress]').forEach((el) => {
            const p = Number(el.getAttribute('data-progress'));
            el.style.width = (Number.isFinite(p) ? Math.max(0, Math.min(100, p)) : 0) + '%';
        });
    </script>
</body>
</html>
