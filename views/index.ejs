<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Bot Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { min-height: 100vh; }
        .nav-link { display: block; padding: 0.5rem 1rem; border-radius: 0.5rem; transition: all 0.2s ease; }
        .nav-link:hover { background-color: #dbeafe; color: #2563eb; }
        .nav-link.active { background-color: #2563eb; color: #ffffff; }
    </style>
</head>
<body class="bg-gray-50">
    <div class="flex">
        <!-- Sidebar -->
        <div class="sidebar bg-white shadow-lg w-64 p-6">
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-blue-600">
                    <i class="fas fa-robot mr-2"></i>Task Bot
                </h1>
            </div>
            
            <nav class="space-y-2">
                <a href="/" class="nav-link active">
                    <i class="fas fa-home mr-2"></i> Dashboard
                </a>
                <a href="/tasks" class="nav-link">
                    <i class="fas fa-tasks mr-2"></i> Tasks
                </a>
                <a href="/users" class="nav-link">
                    <i class="fas fa-users mr-2"></i> Users
                </a>
                <a href="/leaderboard" class="nav-link">
                    <i class="fas fa-trophy mr-2"></i> Leaderboard
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-1">
            <!-- Header -->
            <header class="bg-white shadow">
                <div class="max-w-7xl mx-auto px-6 py-4">
                    <h2 class="text-3xl font-bold text-gray-900">Dashboard</h2>
                </div>
            </header>

            <!-- Content -->
            <main class="max-w-7xl mx-auto px-6 py-8">
                <!-- Stats Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
                    <!-- Total Tasks -->
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-tasks text-blue-600 text-3xl"></i>
                            </div>
                            <div class="ml-5">
                                <p class="text-sm text-gray-500">Total Tasks</p>
                                <p class="text-2xl font-bold text-gray-900"><%= totalTasks %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Total Subtasks -->
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-list text-purple-600 text-3xl"></i>
                            </div>
                            <div class="ml-5">
                                <p class="text-sm text-gray-500">Total Subtasks</p>
                                <p class="text-2xl font-bold text-gray-900"><%= totalSubtasks %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Completed -->
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-check-circle text-green-600 text-3xl"></i>
                            </div>
                            <div class="ml-5">
                                <p class="text-sm text-gray-500">Completed</p>
                                <p class="text-2xl font-bold text-gray-900"><%= completedTasks %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Posted -->
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-share text-orange-600 text-3xl"></i>
                            </div>
                            <div class="ml-5">
                                <p class="text-sm text-gray-500">Posted</p>
                                <p class="text-2xl font-bold text-gray-900"><%= postedTasks %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Total Users -->
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-users text-indigo-600 text-3xl"></i>
                            </div>
                            <div class="ml-5">
                                <p class="text-sm text-gray-500">Total Users</p>
                                <p class="text-2xl font-bold text-gray-900"><%= totalUsers %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">Quick Links</h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <a href="/tasks" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                            <i class="fas fa-tasks mr-2"></i> View Tasks
                        </a>
                        <a href="/users" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-purple-600 hover:bg-purple-700">
                            <i class="fas fa-users mr-2"></i> View Users
                        </a>
                        <a href="/leaderboard" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-orange-600 hover:bg-orange-700">
                            <i class="fas fa-trophy mr-2"></i> Leaderboard
                        </a>
                        <a href="https://discord.com" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
                            <i class="fab fa-discord mr-2"></i> Discord
                        </a>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
