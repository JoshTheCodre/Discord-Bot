<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard — SolomaxStudios Task Manager</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #F5F7FA; }
    </style>
</head>
<body>
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="w-60 bg-white border-r border-gray-200 min-h-screen flex flex-col flex-shrink-0">
            <div class="px-5 py-5 border-b border-gray-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-layer-group text-white" style="font-size:11px;"></i>
                    </div>
                    <div class="min-w-0">
                        <p class="font-semibold text-gray-900 text-xs tracking-tight leading-tight">SolomaxStudios</p>
                        <p class="text-gray-400 text-xs leading-tight">Task Manager</p>
                    </div>
                </div>
            </div>
            <nav class="px-3 py-4 flex-1 space-y-0.5">
                <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm bg-blue-50 text-blue-600 font-medium transition-colors">
                    <i class="fas fa-home w-4 text-center text-blue-500" style="font-size:13px;"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/tasks" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-list-check w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Tasks</span>
                </a>
                <a href="/performance" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-chart-line w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Performance</span>
                </a>
                <a href="/flags" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 transition-colors" onmouseenter="this.style.background='#fef2f2';this.style.color='#dc2626';this.querySelector('i').style.color='#dc2626';" onmouseleave="this.style.background='';this.style.color='';this.querySelector('i').style.color='#9ca3af';">
                    <i class="fas fa-triangle-exclamation w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Flagged</span>
                </a>
                <a href="/logs" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-scroll w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Logs</span>
                </a>
            </nav>
            <!-- Logout -->
            <div class="px-3 py-3 border-t border-gray-100">
                <div class="px-3 py-2 mb-1">
                    <p class="text-xs font-medium text-gray-700 truncate"><%= adminName || 'Admin' %></p>
                    <p class="text-xs text-gray-400">Administrator</p>
                </div>
                <form method="POST" action="/logout">
                    <button type="submit" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 hover:bg-red-50 hover:text-red-600 transition-colors text-left">
                        <i class="fas fa-arrow-right-from-bracket w-4 text-center" style="font-size:13px;"></i>
                        <span>Sign out</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <header class="bg-white border-b border-gray-200 px-8 py-5">
                <h1 class="text-xl font-semibold text-gray-900">Dashboard</h1>
            </header>

            <main class="flex-1 px-8 py-8">

                <!-- Stats Grid -->
                <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-7">

                    <div class="rounded-xl p-5 flex flex-col gap-3" style="background:linear-gradient(135deg,#eff6ff,#dbeafe);border:1px solid #bfdbfe;">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:#2563eb;">
                            <i class="fas fa-layer-group text-white" style="font-size:13px;"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium uppercase tracking-wider mb-1" style="color:#3b82f6;">Total Tasks</p>
                            <p class="text-3xl font-bold" style="color:#1e3a8a;"><%= totalTasks %></p>
                        </div>
                    </div>

                    <div class="rounded-xl p-5 flex flex-col gap-3" style="background:linear-gradient(135deg,#faf5ff,#ede9fe);border:1px solid #ddd6fe;">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:#7c3aed;">
                            <i class="fas fa-list-check text-white" style="font-size:13px;"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium uppercase tracking-wider mb-1" style="color:#7c3aed;">Subtasks</p>
                            <p class="text-3xl font-bold" style="color:#4c1d95;"><%= totalSubtasks %></p>
                        </div>
                    </div>

                    <div class="rounded-xl p-5 flex flex-col gap-3" style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1px solid #bbf7d0;">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:#059669;">
                            <i class="fas fa-circle-check text-white" style="font-size:13px;"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium uppercase tracking-wider mb-1" style="color:#059669;">Completed</p>
                            <p class="text-3xl font-bold" style="color:#064e3b;"><%= completedTasks %></p>
                        </div>
                    </div>

                    <div class="rounded-xl p-5 flex flex-col gap-3" style="background:linear-gradient(135deg,#f0f9ff,#e0f2fe);border:1px solid #bae6fd;">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:#0284c7;">
                            <i class="fas fa-paper-plane text-white" style="font-size:13px;"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium uppercase tracking-wider mb-1" style="color:#0284c7;">Posted</p>
                            <p class="text-3xl font-bold" style="color:#0c4a6e;"><%= postedTasks %></p>
                        </div>
                    </div>

                    <div class="rounded-xl p-5 flex flex-col gap-3" style="background:linear-gradient(135deg,#fffbeb,#fef3c7);border:1px solid #fde68a;">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:#d97706;">
                            <i class="fas fa-users text-white" style="font-size:13px;"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium uppercase tracking-wider mb-1" style="color:#d97706;">Users</p>
                            <p class="text-3xl font-bold" style="color:#78350f;"><%= totalUsers %></p>
                        </div>
                    </div>

                </div>

                <!-- Team Members -->
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-sm font-semibold text-gray-900">Team</h2>
                            <p class="text-xs text-gray-400 mt-0.5"><%= users ? users.length : 0 %> members</p>
                        </div>
                        <a href="/performance" class="text-xs font-medium text-blue-600 hover:text-blue-700 transition-colors">View performance</a>
                    </div>
                    <% if (!users || users.length === 0) { %>
                    <p class="text-sm text-gray-400 text-center py-8">No team members found.</p>
                    <% } else { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                        <% users.forEach((user, uIdx) => { %>
                        <%
                          const uName = user.discordUsername || 'Unknown';
                          const uInitials = String(uName).substring(0, 2).toUpperCase();
                          const uRate = user.completionRate || 0;
                          const barColor  = uRate >= 75 ? '#10b981' : uRate >= 40 ? '#f59e0b' : '#d1d5db';
                          const rateLabel = uRate >= 75 ? 'text-emerald-600' : uRate >= 40 ? 'text-amber-500' : 'text-gray-400';
                        %>
                        <div class="rounded-xl border border-gray-100 p-4 hover:border-gray-200 hover:shadow-sm transition-all" style="background:#fafafa;">
                            <!-- Top row: avatar + name + done badge -->
                            <div class="flex items-center gap-3 mb-3">
                                <div class="user-avatar w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 font-bold" data-idx="<%= uIdx %>" style="font-size:11px;letter-spacing:0.03em;">
                                    <%= uInitials %>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-semibold text-gray-900 truncate"><%= uName %></p>
                                    <p class="text-xs text-gray-400"><%= user.postedCount || 0 %> posted</p>
                                </div>
                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-xs font-bold flex-shrink-0" style="background:#f0fdf4;color:#15803d;border:1.5px solid #6ee7b7;">
                                    <i class="fas fa-check" style="font-size:8px;"></i><%= user.completedCount || 0 %>
                                </span>
                            </div>
                            <!-- Progress row -->
                            <div class="flex items-center gap-2">
                                <div class="flex-1 bg-gray-100 rounded-full" style="height:4px;">
                                    <div class="rounded-full progress-fill" style="height:4px;" data-progress="<%= uRate %>" data-bar-color="<%= barColor %>"></div>
                                </div>
                                <span class="text-xs font-semibold flex-shrink-0 <%= rateLabel %>"><%= uRate %>%</span>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                    <% } %>
                </div>

            </main>
        </div>
    </div>
    <script>
        document.querySelectorAll('.progress-fill[data-progress]').forEach((el) => {
            const p = Number(el.getAttribute('data-progress'));
            el.style.width = (Number.isFinite(p) ? Math.max(0, Math.min(100, p)) : 0) + '%';
            const color = el.getAttribute('data-bar-color');
            if (color) el.style.background = color;
        });

        const avatarGradients = [
            { bg: 'linear-gradient(135deg,#dbeafe,#bfdbfe)', color: '#1d4ed8' },
            { bg: 'linear-gradient(135deg,#ede9fe,#ddd6fe)', color: '#6d28d9' },
            { bg: 'linear-gradient(135deg,#dcfce7,#bbf7d0)', color: '#15803d' },
            { bg: 'linear-gradient(135deg,#fef3c7,#fde68a)', color: '#b45309' },
            { bg: 'linear-gradient(135deg,#fce7f3,#fbcfe8)', color: '#be185d' },
            { bg: 'linear-gradient(135deg,#e0f2fe,#bae6fd)', color: '#0369a1' },
            { bg: 'linear-gradient(135deg,#f0fdf4,#bbf7d0)', color: '#166534' },
            { bg: 'linear-gradient(135deg,#fff7ed,#fed7aa)', color: '#c2410c' },
        ];
        document.querySelectorAll('.user-avatar[data-idx]').forEach((el) => {
            const i = Number(el.getAttribute('data-idx')) % avatarGradients.length;
            el.style.background = avatarGradients[i].bg;
            el.style.color = avatarGradients[i].color;
        });
    </script>
</body>
</html>
