<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leaderboard - Task Bot Dashboard</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #F5F7FA; }
        .tab-btn.active { border-bottom-color: #2563EB; color: #2563EB; }
        .tab-btn { border-bottom: 2px solid transparent; }
    </style>
</head>
<body>
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="w-60 bg-white border-r border-gray-200 min-h-screen flex flex-col flex-shrink-0">
            <div class="px-5 py-5 border-b border-gray-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-layer-group text-white" style="font-size:11px;"></i>
                    </div>
                    <span class="font-semibold text-gray-900 text-sm tracking-tight">Task Bot</span>
                </div>
            </div>
            <nav class="px-3 py-4 flex-1 space-y-0.5">
                <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-home w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/tasks" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-list-check w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Tasks</span>
                </a>
                <a href="/users" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-users w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Users</span>
                </a>
                <a href="/leaderboard" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm bg-blue-50 text-blue-600 font-medium transition-colors">
                    <i class="fas fa-ranking-star w-4 text-center text-blue-500" style="font-size:13px;"></i>
                    <span>Leaderboard</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <header class="bg-white border-b border-gray-200 px-8 py-5">
                <h1 class="text-xl font-semibold text-gray-900">Leaderboard</h1>
            </header>

            <main class="flex-1 px-8 py-7">
                <% if (users.length === 0) { %>
                    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-16 text-center">
                        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fas fa-users text-gray-300" style="font-size:18px;"></i>
                        </div>
                        <p class="text-sm text-gray-500">No users found</p>
                    </div>
                <% } else { %>

                    <!-- Tabs -->
                    <div class="border-b border-gray-200 mb-6">
                        <nav class="flex gap-0 -mb-px">
                            <button onclick="switchTab('completed', this)" class="tab-btn active px-4 py-3 text-sm font-medium transition-colors">By Completed</button>
                            <button onclick="switchTab('posted', this)" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors">By Posted</button>
                            <button onclick="switchTab('total', this)" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors">Total Contributions</button>
                        </nav>
                    </div>

                    <!-- Table -->
                    <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead>
                                    <tr class="bg-gray-50 border-b border-gray-100">
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider w-16">Rank</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">User</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Completed</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Posted</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Total</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Rate</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <% users.forEach((user, index) => { %>
                                    <%
                                      const displayName = user.discordUsername || user.name || user.username || user.discordId || user.id || 'Unknown User';
                                      const displayId = user.discordId || user.id || user.userId || 'N/A';
                                      const initials = String(displayName).substring(0, 2).toUpperCase();
                                      const rate = user.completionRate || 0;
                                    %>
                                    <tr class="hover:bg-gray-50 transition-colors" data-completed="<%= user.completedCount || 0 %>" data-posted="<%= user.postedCount || 0 %>" data-total="<%= user.totalContributions || 0 %>">
                                        <td class="px-6 py-4">
                                            <% if (index === 0) { %>
                                                <span class="text-sm font-bold text-amber-500">1st</span>
                                            <% } else if (index === 1) { %>
                                                <span class="text-sm font-bold text-slate-400">2nd</span>
                                            <% } else if (index === 2) { %>
                                                <span class="text-sm font-bold text-orange-400">3rd</span>
                                            <% } else { %>
                                                <span class="text-sm font-medium text-gray-400">#<%= index + 1 %></span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-xs font-semibold flex-shrink-0">
                                                    <%= initials %>
                                                </div>
                                                <div class="min-w-0">
                                                    <p class="text-sm font-medium text-gray-900 truncate"><%= displayName %></p>
                                                    <p class="text-xs text-gray-400 truncate"><%= displayId %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <%= user.completedCount || 0 %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                                                <%= user.postedCount || 0 %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                                                <%= user.totalContributions || 0 %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-24 bg-gray-100 rounded-full h-1.5 flex-shrink-0">
                                                    <div class="bg-blue-500 h-1.5 rounded-full progress-fill" data-progress="<%= rate %>"></div>
                                                </div>
                                                <span class="text-xs font-medium text-gray-600"><%= rate %>%</span>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                <% } %>
            </main>
        </div>
    </div>

    <script>
        document.querySelectorAll('.progress-fill[data-progress]').forEach((el) => {
            const p = Number(el.getAttribute('data-progress'));
            el.style.width = (Number.isFinite(p) ? Math.max(0, Math.min(100, p)) : 0) + '%';
        });

        function switchTab(tab, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('active');
                b.classList.add('text-gray-500');
                b.classList.remove('text-blue-600');
            });
            btn.classList.add('active');
            btn.classList.remove('text-gray-500');
            btn.classList.add('text-blue-600');

            const rows = Array.from(document.querySelectorAll('tbody tr'));
            rows.sort((a, b) => {
                const key = tab === 'completed' ? 'completed' : tab === 'posted' ? 'posted' : 'total';
                return Number(b.dataset[key]) - Number(a.dataset[key]);
            });
            const tbody = document.querySelector('tbody');
            rows.forEach((r, i) => {
                tbody.appendChild(r);
                const rankCell = r.querySelector('td:first-child span');
                const labels = ['1st','2nd','3rd'];
                const classes = ['text-amber-500','text-slate-400','text-orange-400'];
                if (i < 3) {
                    rankCell.textContent = labels[i];
                    rankCell.className = 'text-sm font-bold ' + classes[i];
                } else {
                    rankCell.textContent = '#' + (i + 1);
                    rankCell.className = 'text-sm font-medium text-gray-400';
                }
            });
        }
    </script>
</body>
</html>
