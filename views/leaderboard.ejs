<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leaderboard - Task Bot Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-50">
    <div class="flex">
        <!-- Sidebar -->
        <div class="bg-white shadow-lg w-64 p-6 min-h-screen">
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-blue-600">
                    <i class="fas fa-robot mr-2"></i>Task Bot
                </h1>
            </div>

            <nav class="space-y-2">
                <a href="/"
                    class="block px-4 py-2 rounded-lg text-gray-700 hover:bg-blue-100">
                    <i class="fas fa-home mr-2"></i> Dashboard
                </a>
                <a href="/tasks"
                    class="block px-4 py-2 rounded-lg text-gray-700 hover:bg-blue-100">
                    <i class="fas fa-tasks mr-2"></i> Tasks
                </a>
                <a href="/users"
                    class="block px-4 py-2 rounded-lg text-gray-700 hover:bg-blue-100">
                    <i class="fas fa-users mr-2"></i> Users
                </a>
                <a href="/leaderboard"
                    class="block px-4 py-2 rounded-lg bg-blue-600 text-white">
                    <i class="fas fa-trophy mr-2"></i> Leaderboard
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-1">
            <!-- Header -->
            <header class="bg-white shadow">
                <div class="max-w-7xl mx-auto px-6 py-4">
                    <h2 class="text-3xl font-bold text-gray-900">
                        <i
                            class="fas fa-trophy text-yellow-500 mr-2"></i>Leaderboard
                    </h2>
                </div>
            </header>

            <!-- Content -->
            <main class="max-w-7xl mx-auto px-6 py-8">
                <% if (users.length === 0) { %>
                <div class="bg-white rounded-lg shadow p-12 text-center">
                    <i class="fas fa-users text-4xl text-gray-400 mb-4"></i>
                    <p class="text-gray-500">No users found</p>
                </div>
                <% } else { %><!-- Tabs -->
                <div class="mb-8 border-b border-gray-200">
                    <nav class="flex space-x-8" aria-label="Tabs">
                        <button onclick="switchTab('completed')"
                            class="py-4 px-1 border-b-2 border-blue-500 text-blue-600 font-medium text-sm">
                            <i class="fas fa-check-circle mr-2"></i>By Completed
                        </button>
                        <button onclick="switchTab('posted')"
                            class="py-4 px-1 border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium text-sm">
                            <i class="fas fa-share mr-2"></i>By Posted
                        </button>
                        <button onclick="switchTab('total')"
                            class="py-4 px-1 border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium text-sm">
                            <i class="fas fa-chart-bar mr-2"></i>Total
                            Contributions
                        </button>
                    </nav>
                </div>

                <!-- Leaderboard Table -->
                <div class="bg-white rounded-lg shadow overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-gray-100 border-b">
                                <tr>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">
                                        Rank</th>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">
                                        User</th>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">
                                        <i
                                            class="fas fa-check-circle text-green-600 mr-1"></i>Completed
                                    </th>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">
                                        <i
                                            class="fas fa-share text-orange-600 mr-1"></i>Posted
                                    </th>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">
                                        <i
                                            class="fas fa-chart-pie text-purple-600 mr-1"></i>Total
                                    </th>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">
                                        Completion Rate</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                <% users.forEach((user, index) => { %>
                                <% const displayName = user.discordUsername || user.name || user.username || user.discordId || user.id || 'Unknown User'; %>
                                <% const displayId = user.discordId || user.id || user.userId || 'N/A'; %>
                                <% const initials = String(displayName).substring(0, 2).toUpperCase(); %>
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-6 py-4">
                                        <% if (index === 0) { %>
                                        <span class="text-2xl">🥇</span>
                                        <% } else if (index === 1) { %>
                                        <span class="text-2xl">🥈</span>
                                        <% } else if (index === 2) { %>
                                        <span class="text-2xl">🥉</span>
                                        <% } else { %><span
                                            class="font-semibold text-gray-900">#
                                            <%= index + 1 %>
                                        </span>

                                        
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center">
                                            <div
                                                class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white text-sm font-bold">
                                                <%= initials %>
                                            </div>
                                            <div class="ml-3">
                                                <p
                                                    class="font-semibold text-gray-900">
                                                    <%= displayName %>
                                                </p>
                                                <p
                                                    class="text-xs text-gray-500">
                                                    <%= displayId %>
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span
                                            class="px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800">
                                            <%= user.completedCount || 0 %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span
                                            class="px-3 py-1 rounded-full text-sm font-semibold bg-orange-100 text-orange-800">
                                            <%= user.postedCount || 0 %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span
                                            class="px-3 py-1 rounded-full text-sm font-semibold bg-purple-100 text-purple-800">
                                            <%= user.totalContributions || 0 %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <% const rate = Math.round((user.completionRate || 0) * 100); %>
                                        <div class="flex items-center">
                                            <div class="w-full bg-gray-200 rounded-full h-2 mr-3"
                                                style="min-width: 100px;">
                                                <div class="bg-blue-600 h-2 rounded-full transition-all progress-fill"
                                                    data-progress="<%= rate %>">
                                                </div>
                                            </div>
                                            <span
                                                class="text-sm font-medium text-gray-900">
                                                <%= rate %>%
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>

                
                <% } %>
            </main>
        </div>
    </div>

    <script>
        document.querySelectorAll('.progress-fill[data-progress]').forEach((element) => {
            const progress = Number(element.getAttribute('data-progress'));
            const normalized = Number.isFinite(progress) ? Math.max(0, Math.min(100, progress)) : 0;
            element.style.width = `${normalized}%`;
        });

        function switchTab(tab) {
            // This is a simple placeholder. In a real app, you'd fetch data for each tab
            const buttons = document.querySelectorAll('nav button');
            buttons.forEach(btn => {
                btn.classList.remove('border-blue-500',
                'text-blue-600');
                btn.classList.add('border-transparent',
                'text-gray-500');
            });

            event.target.closest('button').classList.remove(
                'border-transparent', 'text-gray-500');
            event.target.closest('button').classList.add('border-blue-500',
                'text-blue-600');

            console.log('Switched to:', tab);
        }
    </script>
</body>

</html>