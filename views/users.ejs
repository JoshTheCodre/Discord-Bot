<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users - Task Bot Dashboard</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #F5F7FA; }
    </style>
</head>
<body>
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="w-60 bg-white border-r border-gray-200 min-h-screen flex flex-col flex-shrink-0">
            <div class="px-5 py-5 border-b border-gray-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-layer-group text-white" style="font-size:11px;"></i>
                    </div>
                    <span class="font-semibold text-gray-900 text-sm tracking-tight">Task Bot</span>
                </div>
            </div>
            <nav class="px-3 py-4 flex-1 space-y-0.5">
                <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-home w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/tasks" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-list-check w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Tasks</span>
                </a>
                <a href="/users" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm bg-blue-50 text-blue-600 font-medium transition-colors">
                    <i class="fas fa-users w-4 text-center text-blue-500" style="font-size:13px;"></i>
                    <span>Users</span>
                </a>
                <a href="/leaderboard" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-ranking-star w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Leaderboard</span>
                </a>
                <a href="/copyright" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-red-50 hover:text-red-600 transition-colors">
                    <i class="fas fa-triangle-exclamation w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Copyright</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <header class="bg-white border-b border-gray-200 px-8 py-5">
                <h1 class="text-xl font-semibold text-gray-900">Users</h1>
            </header>

            <main class="flex-1 px-8 py-7">
                <% if (users.length === 0) { %>
                    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-16 text-center">
                        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fas fa-users text-gray-300" style="font-size:18px;"></i>
                        </div>
                        <p class="text-sm text-gray-500">No users found</p>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <% users.forEach(user => { %>
                            <%
                              const displayName = user.discordUsername || user.name || user.username || user.discordId || user.id || 'Unknown User';
                              const displayId = user.discordId || user.id || user.userId || 'N/A';
                              const initials = String(displayName).substring(0, 2).toUpperCase();
                              const rate = user.completionRate || 0;
                              const hasActivity = (user.completedCount || 0) + (user.postedCount || 0) > 0;
                            %>
                            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:border-gray-200 hover:shadow transition-all">
                                <div class="flex items-center gap-3 mb-4">
                                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-xs font-semibold flex-shrink-0">
                                        <%= initials %>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-sm font-semibold text-gray-900 truncate"><%= displayName %></p>
                                        <p class="text-xs text-gray-400 truncate"><%= displayId %></p>
                                    </div>
                                </div>

                                <div class="border-t border-gray-100 pt-4 space-y-2.5">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-gray-500">Completed</span>
                                        <span class="text-sm font-semibold text-emerald-600"><%= user.completedCount || 0 %></span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-gray-500">Posted</span>
                                        <span class="text-sm font-semibold text-blue-600"><%= user.postedCount || 0 %></span>
                                    </div>

                                    <% if (hasActivity) { %>
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-gray-500">Total</span>
                                            <span class="text-sm font-semibold text-gray-700"><%= (user.completedCount || 0) + (user.postedCount || 0) %></span>
                                        </div>
                                        <div class="pt-1">
                                            <div class="flex items-center justify-between mb-1.5">
                                                <span class="text-xs text-gray-400">Completion rate</span>
                                                <span class="text-xs font-medium text-gray-600"><%= rate %>%</span>
                                            </div>
                                            <div class="w-full bg-gray-100 rounded-full h-1.5">
                                                <div class="bg-blue-500 h-1.5 rounded-full progress-fill" data-progress="<%= rate %>"></div>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <p class="text-xs text-gray-400 pt-1">No contributions yet</p>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </main>
        </div>
    </div>
    <script>
        document.querySelectorAll('.progress-fill[data-progress]').forEach((el) => {
            const p = Number(el.getAttribute('data-progress'));
            el.style.width = (Number.isFinite(p) ? Math.max(0, Math.min(100, p)) : 0) + '%';
        });
    </script>
</body>
</html>
