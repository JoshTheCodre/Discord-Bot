<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasks - Task Bot Dashboard</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #F5F7FA; }
        .subtask-body { display: none; }
        .task-card.open .subtask-body { display: block; }
        .task-card.open .chevron { transform: rotate(180deg); }
        .chevron { transition: transform 0.2s ease; }
        .subtask-row:last-child { border-bottom: none; }
        .filter-btn.active { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }
        .task-card.hidden-by-filter { display: none; }
    </style>
</head>
<body>
<div class="flex min-h-screen">

    <!-- Sidebar -->
    <aside class="w-60 bg-white border-r border-gray-200 flex flex-col flex-shrink-0" style="min-height:100vh;">
        <div class="px-5 py-5 border-b border-gray-100">
            <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-layer-group text-white" style="font-size:11px;"></i>
                </div>
                <div class="min-w-0">
                    <p class="font-semibold text-gray-900 text-xs tracking-tight leading-tight">SolomaxStudios</p>
                    <p class="text-gray-400 text-xs leading-tight">Task Manager</p>
                </div>
            </div>
        </div>
        <nav class="px-3 py-4 space-y-0.5 overflow-y-auto flex-1">
            <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                <i class="fas fa-home w-4 text-center text-gray-400" style="font-size:13px;"></i>
                <span>Dashboard</span>
            </a>
            <a href="/tasks" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm bg-blue-50 text-blue-600 font-medium">
                <i class="fas fa-list-check w-4 text-center text-blue-500" style="font-size:13px;"></i>
                <span>Tasks</span>
            </a>
            <a href="/performance" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                <i class="fas fa-chart-line w-4 text-center text-gray-400" style="font-size:13px;"></i>
                <span>Performance</span>
            </a>
            <a href="/flags" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 transition-colors" style="--hover-bg:#fef2f2; --hover-color:#dc2626;"
               onmouseenter="this.style.background='#fef2f2';this.style.color='#dc2626';this.querySelector('i').style.color='#dc2626';"
               onmouseleave="this.style.background='';this.style.color='';this.querySelector('i').style.color='#9ca3af';">
                <i class="fas fa-triangle-exclamation w-4 text-center text-gray-400" style="font-size:13px;"></i>
                <span>Flagged</span>
            </a>
            <a href="/logs" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                <i class="fas fa-scroll w-4 text-center text-gray-400" style="font-size:13px;"></i>
                <span>Logs</span>
            </a>
        </nav>
        <div class="px-3 py-3 border-t border-gray-100">
            <div class="px-3 py-2 mb-1">
                <p class="text-xs font-medium text-gray-700 truncate"><%= adminName || 'Admin' %></p>
                <p class="text-xs text-gray-400">Administrator</p>
            </div>
            <form method="POST" action="/logout">
                <button type="submit" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 hover:bg-red-50 hover:text-red-600 transition-colors text-left">
                    <i class="fas fa-arrow-right-from-bracket w-4 text-center" style="font-size:13px;"></i>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0">
        <header class="bg-white border-b border-gray-200 px-8 py-5">
            <div class="flex items-center justify-between gap-6 flex-wrap">
                <h1 class="text-xl font-semibold text-gray-900">Tasks</h1>
                <div class="flex items-center gap-3 flex-wrap">
                    <!-- User filter -->
                    <select id="user-filter" onchange="applyFilters()"
                            class="text-xs border border-gray-200 rounded-lg px-3 py-1.5 text-gray-600 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">All Members</option>
                        <% (users || []).forEach(u => { %>
                        <option value="<%= u.id %>"><%= u.name %></option>
                        <% }); %>
                    </select>
                    <!-- Time filter -->
                    <div class="flex items-center gap-1 bg-gray-100 rounded-lg p-1">
                        <button onclick="setTimeFilter('all', this)"     class="filter-btn active px-3 py-1.5 rounded-md text-xs font-medium border border-transparent transition-colors">All</button>
                        <button onclick="setTimeFilter('week', this)"    class="filter-btn px-3 py-1.5 rounded-md text-xs font-medium text-gray-500 border border-transparent transition-colors">This Week</button>
                        <button onclick="setTimeFilter('month', this)"   class="filter-btn px-3 py-1.5 rounded-md text-xs font-medium text-gray-500 border border-transparent transition-colors">This Month</button>
                        <button onclick="setTimeFilter('overdue', this)" class="filter-btn px-3 py-1.5 rounded-md text-xs font-medium text-gray-500 border border-transparent transition-colors">Overdue</button>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex-1 px-8 py-7">
            <% if (tasks.length === 0) { %>
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-16 text-center">
                    <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-inbox text-gray-400" style="font-size:18px;"></i>
                    </div>
                    <p class="text-sm text-gray-500">No tasks found</p>
                </div>
            <% } else { %>
                <div id="task-list" class="space-y-3">
                    <% tasks.forEach((task, taskIdx) => { %>
                    <%
                      const completedSubs = task.subTasks?.filter(s => s.status === 'completed').length || 0;
                      const totalSubs     = task.subTasks?.length || 0;
                      const postedSubs    = task.subTasks?.filter(s => s.posted).length || 0;
                      const copyrightSubs = task.subTasks?.filter(s => s.copyrightIssue && !s.copyrightFixed).length || 0;
                      const pct           = totalSubs > 0 ? Math.round((completedSubs / totalSubs) * 100) : 0;
                      const isDone        = task.status === 'completed';
                      const dueDateObj    = task.dueDate ? new Date(task.dueDate + 'T00:00:00') : null;
                      const isOverdue     = !isDone && dueDateObj && dueDateObj < new Date(new Date().toDateString());
                      const cardId        = 'card-' + taskIdx;
                      const assignedName  = task.assignedToName || task.assignedTo || 'Unassigned';
                      const initials      = String(assignedName).substring(0, 2).toUpperCase();
                      const createdRaw    = task.createdAt || task.dateCreated || null;
                      let createdFmt = null;
                      if (createdRaw) {
                        const cd = typeof createdRaw === 'object' && createdRaw.toDate ? createdRaw.toDate() : new Date(createdRaw);
                        if (!isNaN(cd)) createdFmt = cd.toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' });
                      }
                    %>

                    <div class="task-card bg-white rounded-xl border border-gray-100 shadow-sm"
                         id="<%= cardId %>"
                         data-due="<%= task.dueDate || '' %>"
                         data-created="<%= createdRaw || '' %>"
                         data-status="<%= task.status || 'pending' %>"
                         data-copyright-count="<%= copyrightSubs %>"
                         data-assigned-to="<%= task.assignedTo || '' %>">

                        <!-- Card Header -->
                        <button type="button" onclick="toggleCard('<%= cardId %>')"
                                class="w-full text-left p-5 focus:outline-none">

                            <div class="flex items-start gap-4">

                                <!-- Title + meta -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                                        <h3 class="text-sm font-semibold text-gray-900 truncate">
                                            <%= task.movieName || task.title || 'Untitled' %>
                                        </h3>
                                        <span class="js-copyright-header-badge inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-red-50 text-red-600 border border-red-200 flex-shrink-0" <% if (copyrightSubs === 0) { %>hidden<% } %>>
                                            <i class="fas fa-triangle-exclamation" style="font-size:9px;"></i><span class="js-copyright-count"><%= copyrightSubs %></span> copyright
                                        </span>
                                    </div>

                                    <div class="flex items-center gap-4 text-xs text-gray-400 flex-wrap">
                                        <span class="flex items-center gap-1.5">
                                            <div class="w-4 h-4 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white flex-shrink-0" style="font-size:8px;font-weight:700;"><%= initials %></div>
                                            <span class="text-gray-600 font-medium"><%= assignedName %></span>
                                        </span>
                                        <span class="text-gray-300">·</span>
                                        <span>ID: <%= task.taskId || task.id %></span>
                                        <% if (task.dueDate) { %>
                                        <span class="text-gray-300">·</span>
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-calendar-days text-gray-300"></i>
                                            Due <%= task.dueDate %>
                                        </span>
                                        <% } %>
                                        <% if (task.style) { %>
                                        <span class="text-gray-300">·</span>
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-palette text-gray-300"></i>
                                            <%= task.style %>
                                        </span>
                                        <% } %>
                                        <% if (createdFmt) { %>
                                        <span class="text-gray-300">·</span>
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-clock text-gray-300"></i>
                                            Given <%= createdFmt %>
                                        </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Stats + status badge + progress + chevron -->
                                <div class="flex items-center gap-4 flex-shrink-0">
                                    <div class="hidden sm:flex items-center gap-3 text-xs text-gray-400">
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-list-check text-gray-300"></i><span><%= totalSubs %></span>
                                        </span>
                                        <span class="flex items-center gap-1 text-emerald-500">
                                            <i class="fas fa-circle-check"></i><span><%= completedSubs %></span>
                                        </span>
                                        <span class="flex items-center gap-1 text-blue-400">
                                            <i class="fas fa-paper-plane"></i><span><%= postedSubs %></span>
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div class="w-16 bg-gray-100 rounded-full h-1.5">
                                            <div class="bg-blue-500 h-1.5 rounded-full progress-fill" data-progress="<%= pct %>"></div>
                                        </div>
                                        <span class="text-xs font-medium text-gray-400 w-8 text-right"><%= pct %>%</span>
                                    </div>
                                    <!-- Status pill -->
                                    <% if (isDone) { %>
                                        <span style="display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:9999px;font-size:11px;font-weight:600;background:#ecfdf5;color:#059669;border:1px solid #a7f3d0;">
                                            <i class="fas fa-check" style="font-size:9px;"></i>Done
                                        </span>
                                    <% } else if (isOverdue) { %>
                                        <span style="display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:9999px;font-size:11px;font-weight:600;background:#fef2f2;color:#dc2626;border:1px solid #fecaca;">
                                            <i class="fas fa-circle-exclamation" style="font-size:9px;"></i>Overdue
                                        </span>
                                    <% } else { %>
                                        <span style="display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:9999px;font-size:11px;font-weight:600;background:#fffbeb;color:#d97706;border:1px solid #fde68a;">
                                            <i class="fas fa-hourglass-half" style="font-size:9px;"></i>Active
                                        </span>
                                    <% } %>
                                    <i class="fas fa-chevron-down chevron text-gray-300" style="font-size:11px;"></i>
                                </div>
                            </div>
                        </button>

                        <!-- Subtask body -->
                        <div class="subtask-body border-t border-gray-100">
                            <% if (!task.subTasks || task.subTasks.length === 0) { %>
                                <div class="px-6 py-5 text-center">
                                    <p class="text-xs text-gray-400">No subtasks</p>
                                </div>
                            <% } else { %>
                                <div class="grid grid-cols-12 gap-3 px-6 py-2.5 bg-gray-50 border-b border-gray-100 text-xs font-medium text-gray-400 uppercase tracking-wider">
                                    <div class="col-span-4">Name</div>
                                    <div class="col-span-2">Status</div>
                                    <div class="col-span-2">Posted</div>
                                    <div class="col-span-2">Submitted by</div>
                                    <div class="col-span-2">Date</div>
                                </div>
                                <% task.subTasks.forEach(st => { %>
                                <%
                                  const stDone   = st.status === 'completed';
                                  const stPosted = st.posted === true;
                                  const stCopy   = st.copyrightIssue === true;
                                  const stDate   = st.completedAt || st.submittedAt || st.postedAt || null;
                                  const stDateFmt = stDate ? new Date(stDate).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) : null;
                                %>
                                <div class="subtask-row grid grid-cols-12 gap-3 px-6 py-3.5 border-b border-gray-100 hover:bg-gray-50 transition-colors items-start"
                                     data-subtask-title="<%= st.title %>"
                                     data-copyright-issue="<%= stCopy ? 'true' : 'false' %>"
                                     data-copyright-fixed="<%= st.copyrightFixed ? 'true' : 'false' %>">
                                    <div class="col-span-4 min-w-0">
                                        <p class="text-sm font-medium text-gray-800 truncate"><%= st.title %></p>
                                        <p class="js-copyright-badge text-xs text-red-500 mt-0.5 flex items-center gap-1" <% if (!stCopy || st.copyrightFixed) { %>hidden<% } %>>
                                            <i class="fas fa-triangle-exclamation" style="font-size:10px;"></i>
                                            <%= st.copyrightNote || 'Copyright issue' %>
                                        </p>
                                    </div>
                                    <div class="col-span-2">
                                        <% if (stDone) { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <i class="fas fa-check" style="font-size:9px;"></i> Completed
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500 border border-gray-200">Pending</span>
                                        <% } %>
                                    </div>
                                    <div class="col-span-2">
                                        <% if (stPosted) { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                                                <i class="fas fa-paper-plane" style="font-size:9px;"></i> Posted
                                            </span>
                                            <% if (st.postedBy) { %><p class="text-xs text-gray-400 mt-0.5"><%= st.postedBy %></p><% } %>
                                        <% } else { %>
                                            <span class="text-xs text-gray-300">—</span>
                                        <% } %>
                                    </div>
                                    <div class="col-span-2">
                                        <% if (st.submittedBy) { %>
                                            <p class="text-xs text-gray-600 font-medium"><%= st.submittedBy %></p>
                                        <% } else { %><span class="text-xs text-gray-300">—</span><% } %>
                                    </div>
                                    <div class="col-span-2">
                                        <% if (stDateFmt) { %>
                                            <p class="text-xs text-gray-400"><%= stDateFmt %></p>
                                        <% } else { %><span class="text-xs text-gray-300">—</span><% } %>
                                    </div>
                                </div>
                                <% }); %>
                            <% } %>

                            <!-- Conflicts section (stored as fixes in DB) -->
                            <% if (task.fixes && task.fixes.length > 0) { %>
                            <div class="border-t border-amber-100">
                                <div class="px-6 py-2.5 bg-amber-50 flex items-center gap-2">
                                    <i class="fas fa-code-merge text-amber-500" style="font-size:11px;"></i>
                                    <span class="text-xs font-semibold text-amber-700 uppercase tracking-wider">Conflicts</span>
                                    <span class="text-xs text-amber-500 font-medium"><%= task.fixes.length %> duplicate<%= task.fixes.length !== 1 ? 's' : '' %> merged</span>
                                </div>
                                <% task.fixes.forEach((fix, fi) => { %>
                                <%
                                  const fixDate = fix.addedAt ? new Date(fix.addedAt).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) : null;
                                  const fixSubtasks = fix.subTasks || [];
                                %>
                                <div class="px-6 py-3 border-b border-amber-50 last:border-b-0">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="flex-1 min-w-0">
                                            <p class="text-xs font-semibold text-gray-700"><%= fix.movieName || 'Untitled' %></p>
                                            <div class="flex items-center gap-3 mt-0.5 flex-wrap">
                                                <% if (fix.dueDate) { %>
                                                <span class="text-xs text-gray-400"><i class="fas fa-calendar-days mr-1" style="font-size:9px;"></i><%= fix.dueDate %></span>
                                                <% } %>
                                                <% if (fixSubtasks.length > 0) { %>
                                                <span class="text-xs text-gray-400"><i class="fas fa-list-check mr-1" style="font-size:9px;"></i><%= fixSubtasks.length %> subtask<%= fixSubtasks.length !== 1 ? 's' : '' %></span>
                                                <% } %>
                                                <% if (fix.style) { %>
                                                <span class="text-xs text-gray-400"><i class="fas fa-palette mr-1" style="font-size:9px;"></i><%= fix.style %></span>
                                                <% } %>
                                            </div>
                                            <% if (fixSubtasks.length > 0) { %>
                                            <ul class="mt-1.5 space-y-0.5">
                                                <% fixSubtasks.forEach(fst => { %>
                                                <li class="text-xs text-gray-500 flex items-center gap-1.5">
                                                    <i class="fas fa-circle text-gray-300" style="font-size:5px;"></i>
                                                    <%= fst.title || fst.subTaskID || fst %>
                                                </li>
                                                <% }); %>
                                            </ul>
                                            <% } %>
                                        </div>
                                        <% if (fixDate) { %>
                                        <span class="text-xs text-gray-400 flex-shrink-0"><%= fixDate %></span>
                                        <% } %>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>
                        </div>

                    </div>
                    <% }); %>
                </div>

                <div id="empty-filter" class="hidden bg-white rounded-xl border border-gray-100 shadow-sm p-12 text-center">
                    <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
                        <i class="fas fa-calendar-xmark text-gray-300" style="font-size:16px;"></i>
                    </div>
                    <p class="text-sm text-gray-500">No tasks match this filter</p>
                </div>
            <% } %>
        </main>
    </div>
</div>

<script>
    document.querySelectorAll('.progress-fill[data-progress]').forEach((el) => {
        const p = Number(el.getAttribute('data-progress'));
        el.style.width = (Number.isFinite(p) ? Math.max(0, Math.min(100, p)) : 0) + '%';
    });

    function toggleCard(id) {
        document.getElementById(id).classList.toggle('open');
    }

    function parseDate(str) {
        if (!str) return null;
        // YYYY-MM-DD parses as UTC midnight — append time to force local timezone
        if (/^\d{4}-\d{2}-\d{2}$/.test(str)) return new Date(str + 'T00:00:00');
        const d = new Date(str);
        return isNaN(d) ? null : d;
    }

    function getWeekBounds() {
        const now = new Date();
        const day = now.getDay();
        const startOfWeek = new Date(now);
        startOfWeek.setDate(now.getDate() - day);
        startOfWeek.setHours(0, 0, 0, 0);
        const endOfWeek = new Date(startOfWeek);
        endOfWeek.setDate(startOfWeek.getDate() + 6);
        endOfWeek.setHours(23, 59, 59, 999);
        return { start: startOfWeek, end: endOfWeek };
    }

    function getMonthBounds() {
        const now = new Date();
        const start = new Date(now.getFullYear(), now.getMonth(), 1);
        const end   = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59, 999);
        return { start, end };
    }

    // Cross-tab realtime update from /flags page
    try {
        const bc = new BroadcastChannel('task_updates');
        bc.onmessage = ({ data }) => {
            if (data.type !== 'copyright_toggle') return;
            const title = data.subtaskTitle;
            const row = document.querySelector(`[data-subtask-title="${CSS.escape(title)}"]`);
            if (!row) return;

            row.dataset.copyrightFixed = String(data.fixed);
            const rowBadge = row.querySelector('.js-copyright-badge');
            if (rowBadge) rowBadge.hidden = data.fixed;

            const card = row.closest('.task-card');
            if (card) {
                const current = parseInt(card.dataset.copyrightCount || '0', 10);
                const next = data.fixed ? Math.max(0, current - 1) : current + 1;
                card.dataset.copyrightCount = String(next);
                const headerBadge = card.querySelector('.js-copyright-header-badge');
                if (headerBadge) {
                    headerBadge.hidden = next === 0;
                    const countEl = headerBadge.querySelector('.js-copyright-count');
                    if (countEl) countEl.textContent = next;
                }
            }
        };
    } catch (_) {}

    let activeTimeFilter = 'all';

    function setTimeFilter(type, btn) {
        activeTimeFilter = type;
        document.querySelectorAll('.filter-btn').forEach(b => {
            b.classList.remove('active');
            b.classList.add('text-gray-500');
            b.style.background = '';
            b.style.color = '';
        });
        btn.classList.add('active');
        btn.classList.remove('text-gray-500');
        applyFilters();
    }

    function applyFilters() {
        const today  = new Date(); today.setHours(0,0,0,0);
        const week   = getWeekBounds();
        const month  = getMonthBounds();
        const userId = document.getElementById('user-filter')?.value || '';
        const cards  = document.querySelectorAll('.task-card');
        let visible  = 0;

        cards.forEach(card => {
            const due        = parseDate(card.dataset.due);
            const created    = parseDate(card.dataset.created);
            const status     = card.dataset.status;
            const assignedTo = card.dataset.assignedTo || '';

            // User filter
            const userMatch = !userId || assignedTo === userId;

            // Time filter
            let timeMatch = true;
            if (activeTimeFilter === 'week') {
                const dueThisWeek   = due     !== null && due     >= week.start && due     <= week.end;
                const givenThisWeek = created !== null && created >= week.start && created <= week.end;
                timeMatch = dueThisWeek || givenThisWeek;
            } else if (activeTimeFilter === 'month') {
                const dueThisMonth   = due     !== null && due     >= month.start && due     <= month.end;
                const givenThisMonth = created !== null && created >= month.start && created <= month.end;
                timeMatch = dueThisMonth || givenThisMonth;
            } else if (activeTimeFilter === 'overdue') {
                timeMatch = due !== null && due < today && status !== 'completed';
            }

            const show = userMatch && timeMatch;
            card.classList.toggle('hidden-by-filter', !show);
            if (show) visible++;
        });

        const emptyMsg = document.getElementById('empty-filter');
        if (emptyMsg) emptyMsg.classList.toggle('hidden', visible > 0 || (activeTimeFilter === 'all' && !userId));
    }
</script>
</body>
</html>
