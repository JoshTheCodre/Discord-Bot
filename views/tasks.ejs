<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasks - Task Bot Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <div class="flex">
        <!-- Sidebar -->
        <div class="bg-white shadow-lg w-64 p-6 min-h-screen">
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-blue-600">
                    <i class="fas fa-robot mr-2"></i>Task Bot
                </h1>
            </div>
            
            <nav class="space-y-2">
                <a href="/" class="block px-4 py-2 rounded-lg text-gray-700 hover:bg-blue-100">
                    <i class="fas fa-home mr-2"></i> Dashboard
                </a>
                <a href="/tasks" class="block px-4 py-2 rounded-lg bg-blue-600 text-white">
                    <i class="fas fa-tasks mr-2"></i> Tasks
                </a>
                <a href="/users" class="block px-4 py-2 rounded-lg text-gray-700 hover:bg-blue-100">
                    <i class="fas fa-users mr-2"></i> Users
                </a>
                <a href="/leaderboard" class="block px-4 py-2 rounded-lg text-gray-700 hover:bg-blue-100">
                    <i class="fas fa-trophy mr-2"></i> Leaderboard
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-1">
            <!-- Header -->
            <header class="bg-white shadow">
                <div class="max-w-7xl mx-auto px-6 py-4">
                    <h2 class="text-3xl font-bold text-gray-900">Tasks</h2>
                </div>
            </header>

            <!-- Content -->
            <main class="max-w-7xl mx-auto px-6 py-8">
                <% if (tasks.length === 0) { %>
                    <div class="bg-white rounded-lg shadow p-12 text-center">
                        <i class="fas fa-inbox text-4xl text-gray-400 mb-4"></i>
                        <p class="text-gray-500">No tasks found</p>
                    </div>
                <% } else { %>
                    <div class="space-y-4">
                        <% tasks.forEach(task => { %>
                            <div class="bg-white rounded-lg shadow hover:shadow-lg transition">
                                <a href="/tasks/<%= task.id %>" class="block p-6 hover:bg-gray-50">
                                    <div class="flex justify-between items-start mb-4">
                                        <div class="flex-1">
                                            <h3 class="text-xl font-semibold text-gray-900"><%= task.title %></h3>
                                            <p class="text-sm text-gray-500 mt-1">
                                                <i class="fas fa-id-card mr-1"></i> ID: <%= task.id %>
                                            </p>
                                        </div>
                                        <span class="px-3 py-1 rounded-full text-sm font-medium <%= task.completed ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                            <%= task.completed ? 'Completed' : 'In Progress' %>
                                        </span>
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
                                        <div class="flex items-center">
                                            <i class="fas fa-list text-blue-600 mr-2"></i>
                                            <span class="text-sm text-gray-600"><%= task.subtasks?.length || 0 %> subtasks</span>
                                        </div>
                                        <div class="flex items-center">
                                            <i class="fas fa-check-circle text-green-600 mr-2"></i>
                                            <span class="text-sm text-gray-600"><%= task.subtasks?.filter(s => s.completed).length || 0 %> completed</span>
                                        </div>
                                        <div class="flex items-center">
                                            <i class="fas fa-share text-orange-600 mr-2"></i>
                                            <span class="text-sm text-gray-600"><%= task.subtasks?.filter(s => s.posted).length || 0 %> posted</span>
                                        </div>
                                        <div class="flex items-center">
                                            <i class="fas fa-warning text-red-600 mr-2"></i>
                                            <span class="text-sm text-gray-600"><%= task.subtasks?.filter(s => s.copyrightIssue).length || 0 %> copyright issues</span>
                                        </div>
                                    </div>

                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <% const completed = task.subtasks?.filter(s => s.completed).length || 0; const total = task.subtasks?.length || 1; const percent = Math.round((completed / total) * 100); %>
                                        <div class="bg-blue-600 h-2 rounded-full progress-fill" data-progress="<%= percent %>"></div>
                                    </div>
                                    <p class="text-xs text-gray-500 mt-2"><%= percent %>% completion</p>
                                </a>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </main>
        </div>
    </div>
    <script>
        document.querySelectorAll('.progress-fill[data-progress]').forEach((element) => {
            const progress = Number(element.getAttribute('data-progress'));
            const normalized = Number.isFinite(progress) ? Math.max(0, Math.min(100, progress)) : 0;
            element.style.width = `${normalized}%`;
        });
    </script>
</body>
</html>
