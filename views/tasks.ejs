<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasks - Task Bot Dashboard</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #F5F7FA; }
    </style>
</head>
<body>
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="w-60 bg-white border-r border-gray-200 min-h-screen flex flex-col flex-shrink-0">
            <div class="px-5 py-5 border-b border-gray-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-layer-group text-white" style="font-size:11px;"></i>
                    </div>
                    <span class="font-semibold text-gray-900 text-sm tracking-tight">Task Bot</span>
                </div>
            </div>
            <nav class="px-3 py-4 flex-1 space-y-0.5">
                <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-home w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/tasks" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm bg-blue-50 text-blue-600 font-medium transition-colors">
                    <i class="fas fa-list-check w-4 text-center text-blue-500" style="font-size:13px;"></i>
                    <span>Tasks</span>
                </a>
                <a href="/users" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-users w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Users</span>
                </a>
                <a href="/leaderboard" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                    <i class="fas fa-ranking-star w-4 text-center text-gray-400" style="font-size:13px;"></i>
                    <span>Leaderboard</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <header class="bg-white border-b border-gray-200 px-8 py-5">
                <h1 class="text-xl font-semibold text-gray-900">Tasks</h1>
            </header>

            <main class="flex-1 px-8 py-7">
                <% if (tasks.length === 0) { %>
                    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-16 text-center">
                        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fas fa-inbox text-gray-400" style="font-size:18px;"></i>
                        </div>
                        <p class="text-sm text-gray-500">No tasks found</p>
                    </div>
                <% } else { %>
                    <div class="space-y-3">
                        <% tasks.forEach(task => { %>
                            <%
                              const completedSubs = task.subTasks?.filter(s => s.status === 'completed').length || 0;
                              const totalSubs = task.subTasks?.length || 0;
                              const postedSubs = task.subTasks?.filter(s => s.posted).length || 0;
                              const copyrightSubs = task.subTasks?.filter(s => s.copyrightIssue).length || 0;
                              const pct = totalSubs > 0 ? Math.round((completedSubs / totalSubs) * 100) : 0;
                              const isDone = task.status === 'completed';
                            %>
                            <a href="/tasks/<%= task.taskId || task.id %>" class="block bg-white rounded-xl border border-gray-100 shadow-sm hover:border-gray-200 hover:shadow transition-all">
                                <div class="p-5">
                                    <div class="flex items-start justify-between gap-4 mb-4">
                                        <div class="min-w-0">
                                            <h3 class="text-sm font-semibold text-gray-900 truncate"><%= task.movieName || task.title || 'Untitled' %></h3>
                                            <p class="text-xs text-gray-400 mt-0.5">ID: <%= task.taskId || task.id %></p>
                                        </div>
                                        <span class="flex-shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border
                                            <%= isDone ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200' %>">
                                            <%= isDone ? 'Completed' : 'In Progress' %>
                                        </span>
                                    </div>

                                    <div class="flex items-center gap-6 mb-4 text-xs text-gray-500">
                                        <span class="flex items-center gap-1.5">
                                            <i class="fas fa-list-check text-gray-300"></i>
                                            <span><%= totalSubs %> subtasks</span>
                                        </span>
                                        <span class="flex items-center gap-1.5">
                                            <i class="fas fa-circle-check text-emerald-400"></i>
                                            <span><%= completedSubs %> completed</span>
                                        </span>
                                        <span class="flex items-center gap-1.5">
                                            <i class="fas fa-paper-plane text-blue-400"></i>
                                            <span><%= postedSubs %> posted</span>
                                        </span>
                                        <% if (copyrightSubs > 0) { %>
                                        <span class="flex items-center gap-1.5">
                                            <i class="fas fa-triangle-exclamation text-red-400"></i>
                                            <span class="text-red-500"><%= copyrightSubs %> copyright</span>
                                        </span>
                                        <% } %>
                                    </div>

                                    <div class="w-full bg-gray-100 rounded-full h-1.5">
                                        <div class="bg-blue-500 h-1.5 rounded-full progress-fill" data-progress="<%= pct %>"></div>
                                    </div>
                                    <p class="text-xs text-gray-400 mt-1.5"><%= pct %>% completion</p>
                                </div>
                            </a>
                        <% }); %>
                    </div>
                <% } %>
            </main>
        </div>
    </div>
    <script>
        document.querySelectorAll('.progress-fill[data-progress]').forEach((el) => {
            const p = Number(el.getAttribute('data-progress'));
            el.style.width = (Number.isFinite(p) ? Math.max(0, Math.min(100, p)) : 0) + '%';
        });
    </script>
</body>
</html>
